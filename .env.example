# --- Which model runs the agents: auto | anthropic | local | rules
#   auto = Claude when ANTHROPIC_API_KEY is set, else a local server when LOCAL_LLM_URL is set, else rules only
LLM_PROVIDER=auto
# --- Claude API (agents). Without a key the app runs on its rule engine only.
ANTHROPIC_API_KEY=
# Personal data (ИИН, phones, cards, IBAN, e-mail) is masked before it is sent to Claude; 0 disables
PII_MASK=1
# --- On-prem model: any OpenAI-compatible server (Ollama, vLLM, LM Studio, KazLLM). The ТЗ stays in your network.
# LOCAL_LLM_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=qwen2.5:14b-instruct
# LOCAL_MODEL_FAST= / LOCAL_MODEL_STRONG= / LOCAL_MODEL_LEAD=   (per role, optional)
# LOCAL_LLM_KEY=
# LOCAL_LLM_TIMEOUT=180
# Models per role (defaults shown): specialists / critic & moderator / client summary
# LLM_MODEL_FAST=claude-haiku-5-5
# LLM_MODEL_STRONG=claude-sonnet-5-5
# LLM_MODEL_LEAD=claude-opus-5-5
# Hard cap of Claude calls per check, and how many findings the Critic may dispute
LLM_MAX_CALLS=24
# free web research for agents (DuckDuckGo / Wikipedia, no keys); 0 disables
WEB_RESEARCH=1
WEB_MAX_CALLS=6
WEB_PAGE_TTL_DAYS=3
# persistent cache of agent answers + team experience (data/cache.sqlite); 0 disables
CACHE=1
CACHE_TTL_DAYS=30
LEARNING=1
DEBATE_MAX_CHALLENGES=6
LLM_TIMEOUT=90

# --- Supabase (accounts + saved checks). Server-side only: never put the secret key in frontend code.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Pacing of the progress animation when Claude is not configured (0 = instant)
DEMO_DELAY_SCALE=1.0
PRODUCT_NAME=Specta
