# Specta — пример конфигурации. Скопируйте в .env и впишите ключ: cp .env.example .env
# ВНИМАНИЕ: .env с реальными ключами не коммитится (он в .gitignore).

# --- Google Gemini (бесплатно; формулировки слабее, чем у Claude): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MODEL_STRONG=gemini-2.5-pro     # для Критика и проверки набора (необязательно)

# --- Which model runs the agents: auto | gemini | anthropic | openai | deepseek | custom | rules
#   auto = the first key found: Anthropic, Gemini, OpenAI, DeepSeek, custom; no key → rules only
LLM_PROVIDER=auto
# --- Claude API. Для сдачи точнее Gemini: https://console.anthropic.com/settings/keys
# Без ключа Claude и без других ключей сервис работает на правилах.
ANTHROPIC_API_KEY=
# Personal data (ИИН, phones, cards, IBAN, e-mail) is masked before it is sent to the model; 0 disables
PII_MASK=1
# --- Other LLM APIs (any one is enough; LLM_PROVIDER=auto takes the first key it finds)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# Any other OpenAI-compatible API (OpenRouter, Groq, Mistral, Together…):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=
# <PROVIDER>_MODEL_STRONG=   a bigger model for the Critic and the set check (optional, e.g. GEMINI_MODEL_STRONG)
# Claude models per role (defaults shown): requirements & questions / set & Critic / client summary on the website
# CLAUDE_MODEL_FAST=claude-haiku-5-5
# CLAUDE_MODEL_STRONG=claude-sonnet-5-5
# CLAUDE_MODEL_LEAD=claude-opus-5-5
# Hard cap of model calls per check, and how many findings the Critic may dispute
LLM_MAX_CALLS=24
# free web research for agents (DuckDuckGo / Wikipedia, no keys); 0 disables
WEB_RESEARCH=1
WEB_MAX_CALLS=6
WEB_PAGE_TTL_DAYS=3
# persistent cache of agent answers + team experience (data/cache.sqlite); 0 disables
CACHE=1
CACHE_TTL_DAYS=30
LEARNING=1
DEBATE_MAX_CHALLENGES=6
LLM_TIMEOUT=90
# how many requirement batches the CLI checks in parallel (lower it on a strict free tier)
REVIEW_PARALLEL=4

# --- Checks are stored locally in data/specta.sqlite. No account and no external database.
# Set STORAGE=supabase only if you deliberately want Supabase Auth and its tables.
# STORAGE=local
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=

# Pacing of the progress animation when Claude is not configured (0 = instant)
DEMO_DELAY_SCALE=1.0
PRODUCT_NAME=Specta
